                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or invalid bearer token (problem+json)"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "The verified caller identity and tenant",
