# INPROOM local development defaults. LOCAL ONLY - not secrets, never use in shared or production environments.
# `make setup` copies this file to .env (git-ignored). Edit .env, not this file, to change local ports.

POSTGRES_USER=inproom
POSTGRES_PASSWORD=inproom
POSTGRES_DB=inproom
POSTGRES_PORT=55432

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=18080

OBJECTSTORE_PORT=18333

API_PORT=8000
WEB_PORT=3000

INPROOM_ENV=local
INPROOM_DATABASE_URL=postgresql+psycopg://inproom:inproom@localhost:55432/inproom
INPROOM_TEST_DATABASE_URL=postgresql+psycopg://inproom:inproom@localhost:55432/inproom_test

# Real-token integration test (local stack only; skipped in CI)
INPROOM_TEST_KEYCLOAK_URL=http://localhost:18080

# Web (Auth.js) - LOCAL ONLY. Generate a real secret for any shared environment: `npx auth secret`.
AUTH_SECRET=local-dev-only-inproom-auth-secret-change-me-0123456789
AUTH_KEYCLOAK_ISSUER=http://localhost:18080/realms/inproom
AUTH_KEYCLOAK_ID=inproom-web
INPROOM_API_URL=http://localhost:8000

# Connector credential vault (INPROOM-108). Locally a built-in development key is used when unset; any shared
# environment MUST set its own key: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# INPROOM_SECRETS_KEY=
# INPROOM_SECRETS_KEY_ID=k1
# Hosts the API may call as Git providers (SSRF allowlist). Hostnames are HTTPS-only; full origins are exact.
INPROOM_GIT_ALLOWED_HOSTS=api.github.com
# Jira sites the API may call. One leading wildcard label is allowed (*.atlassian.net matches acme.atlassian.net).
INPROOM_JIRA_ALLOWED_HOSTS=*.atlassian.net
# Confluence sites the API may call (same rules as the Jira list).
INPROOM_CONFLUENCE_ALLOWED_HOSTS=*.atlassian.net

# Embeddings (INPROOM-204). Default: the deterministic local embedder (no network). For real semantic
# retrieval use any OpenAI-compatible /embeddings API, e.g. Voyage AI, OpenAI or a self-hosted Ollama/vLLM:
# INPROOM_EMBEDDING_PROVIDER=openai-compatible
# INPROOM_EMBEDDING_BASE_URL=https://api.voyageai.com/v1
# INPROOM_EMBEDDING_MODEL=voyage-3.5
# INPROOM_EMBEDDING_DIMENSIONS=1024
# INPROOM_EMBEDDING_API_KEY=            # a deployment secret; never commit it
# INPROOM_EMBEDDING_INPUT_TYPE=true     # Voyage AI: send input_type document/query
# INPROOM_EMBEDDING_ALLOWED_HOSTS=api.voyageai.com, api.openai.com   # add http://localhost:11434 for Ollama
