# INPROOM local development defaults. LOCAL ONLY - not secrets, never use in shared or production environments.
# `make setup` copies this file to .env (git-ignored). Edit .env, not this file, to change local ports.

POSTGRES_USER=inproom
POSTGRES_PASSWORD=inproom
POSTGRES_DB=inproom
POSTGRES_PORT=55432

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=18080

OBJECTSTORE_PORT=18333

API_PORT=8000
WEB_PORT=3000

INPROOM_ENV=local
INPROOM_DATABASE_URL=postgresql+psycopg://inproom:inproom@localhost:55432/inproom
INPROOM_TEST_DATABASE_URL=postgresql+psycopg://inproom:inproom@localhost:55432/inproom

# Real-token integration test (local stack only; skipped in CI)
INPROOM_TEST_KEYCLOAK_URL=http://localhost:18080

# Web (Auth.js) - LOCAL ONLY. Generate a real secret for any shared environment: `npx auth secret`.
AUTH_SECRET=local-dev-only-inproom-auth-secret-change-me-0123456789
AUTH_KEYCLOAK_ISSUER=http://localhost:18080/realms/inproom
AUTH_KEYCLOAK_ID=inproom-web
INPROOM_API_URL=http://localhost:8000
